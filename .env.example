# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略
APP_NAME=DormitoryManagementSystem
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dormitory_db
DB_USER=dorm_app
DB_PASSWORD=change_me

# 后端 JWT 配置
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# 文件上传
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=5

# 首次创建管理员使用；创建后请修改密码
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_me_admin_password
